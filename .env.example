# Copie este arquivo para .env e troque as senhas antes de subir.

# Porta em que o sistema fica disponível no computador/servidor.
# Atrás de um proxy use só o endereço local, por exemplo: APP_PORT=127.0.0.1:3290
APP_PORT=3040

# Banco de dados Postgres
POSTGRES_DB=cadastro_visitas
POSTGRES_USER=cadastro
POSTGRES_PASSWORD=troque-esta-senha

# Chave que assina o login do painel (mínimo 32 caracteres).
# Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres

# Primeiro super admin, criado automaticamente quando ainda não existe nenhum
SUPERADMIN_NAME=Administrador
SUPERADMIN_EMAIL=admin@exemplo.com
SUPERADMIN_PASSWORD=troque-esta-senha
